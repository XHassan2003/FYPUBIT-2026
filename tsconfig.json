{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Named explicitly because TypeScript was not picking @types/jest up on its
    // own here, so `describe` and `expect` came out as "Cannot find name" in
    // store/__tests__ even though the tests ran green under Jest. Listing the
    // global type packages is also simply more predictable than relying on
    // whatever happens to be in node_modules/@types.
    //
    // Only *global* types belong here. Everything else the app uses — React,
    // Expo, React Native — arrives through imports and is unaffected.
    "types": [
      "jest"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
