# Copy this file to .env and fill in the value.
#
# Get the key from https://dashboard.clerk.com -> your app -> API keys ->
# "Publishable key". It starts with pk_test_ while you are developing.
#
# This key is designed to be public — it ends up inside the app bundle either
# way — so it is safe to share with the team. It is NOT the secret key; never
# put anything starting with sk_ in here.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Y2FsbS1wb3NzdW0tODEuY2xlcmsuYWNjb3VudHMuZGV2JA

# Optional. Only set this if the recommendation service is somewhere other than
# the machine running the dev server, e.g. a deployed instance.
# EXPO_PUBLIC_API_URL=http://10.0.0.5:8000
